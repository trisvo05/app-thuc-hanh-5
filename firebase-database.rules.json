{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['fullName', 'email'])"
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['online', 'lastSeen'])"
      }
    },
    "conversations": {
      "$conversationId": {
        ".read": "auth != null && data.child('participants').child(auth.uid).val() === true",
        ".write": "auth != null && !data.exists() && newData.child('participants').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['participants', 'createdAt'])",
        "participants": {
          "$uid": {
            ".validate": "newData.val() === true && root.child('users').child($uid).exists()"
          }
        }
      }
    },
    "userConversations": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".indexOn": ["updatedAt"],
        "$conversationId": {
          ".write": "auth != null && root.child('conversations').child($conversationId).child('participants').child(auth.uid).val() === true && root.child('conversations').child($conversationId).child('participants').child($uid).val() === true",
          ".validate": "newData.hasChildren(['updatedAt', 'unreadCount']) && newData.child('updatedAt').isNumber() && newData.child('unreadCount').isNumber() && newData.child('unreadCount').val() >= 0"
        }
      }
    },
    "messages": {
      "$conversationId": {
        ".read": "auth != null && root.child('conversations').child($conversationId).child('participants').child(auth.uid).val() === true",
        "$messageId": {
          ".write": "auth != null && !data.exists() && root.child('conversations').child($conversationId).child('participants').child(auth.uid).val() === true && newData.child('senderId').val() === auth.uid && root.child('conversations').child($conversationId).child('participants').child(newData.child('receiverId').val()).val() === true && newData.child('receiverId').val() !== auth.uid",
          ".validate": "newData.hasChildren(['senderId', 'receiverId', 'type', 'createdAt']) && newData.child('createdAt').isNumber() && ((newData.child('type').val() === 'text' && newData.child('text').isString() && newData.child('text').val().length > 0) || (newData.child('type').val() === 'location' && newData.child('latitude').isNumber() && newData.child('longitude').isNumber()))"
        }
      }
    }
  }
}
